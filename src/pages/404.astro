---
import Base from '../layouts/Base.astro';
import Cross from '../components/Cross.astro';
import Icon from '../components/Icon.astro';
---
<Base lang="en" title="Page not found" description="This page could not be found.">
  <section class="section center nf">
    <div class="wrap wrap-narrow">
      <div class="divider"><Cross /></div>
      <p class="eyebrow">404</p>
      <h1>This page has wandered off</h1>
      <p class="lede">The page you were looking for may have moved when our website was redesigned. Try one of these instead.</p>
      <p class="lede" lang="ar" dir="rtl">الصفحة التي تبحث عنها غير موجودة. جرّب إحدى الصفحات التالية.</p>
      <div class="btn-row">
        <a class="btn" href="/">Home</a>
        <a class="btn btn-ghost" href="/mass-times"><Icon name="clock" /> Mass Times</a>
        <a class="btn btn-ghost" href="/ministries">Ministries</a>
        <a class="btn btn-ghost" href="/contact">Contact</a>
        <a class="btn btn-ghost" href="/ar">العربية</a>
      </div>
    </div>
  </section>
</Base>
<style>.nf { min-height: 60vh; display: grid; place-items: center; }</style>
