---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ScheduleWeek from '../components/ScheduleWeek.astro';
import Icon from '../components/Icon.astro';
import { site, type Lang } from '../data/site';
import { href, routes } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;

const c = {
  en: {
    title: 'Mass Times & Sacraments',
    desc: 'Weekly Mass times at Sacred Heart Chaldean Catholic Church in Warren, MI: Friday & Saturday 6 PM (Sureth & Arabic), Saturday 12:30 PM (English), Sunday 10 AM (Arabic) and 12:30 PM (Sureth). Confessions Fri & Sat 4–5 PM.',
    eyebrow: 'Worship With Us',
    lede: 'The Holy Qurbana is the heart of our parish life. All are welcome at every Mass.',
    weekTitle: 'Weekly Schedule',
    weekNote: 'Times can change on holidays and feast days. When they do, we announce it at Mass and on Instagram.',
    cards: [
      ['cross', 'Holy Mass', 'Celebrated in Sureth (modern Aramaic), Arabic and English. The Saturday 12:30 PM Mass is in English and is attended by our Catechism and First Communion families.'],
      ['heart', 'Confession', 'The Sacrament of Reconciliation is offered every Friday and Saturday from 4 to 5 PM, before Mass. To schedule another time, call the office.'],
      ['candle', 'Adoration & Rosary', 'Spend an hour with the Lord before the Blessed Sacrament. Adoration and the Rosary are prayed every Friday and Saturday from 5 to 6 PM.'],
    ],
    feastTitle: 'Feast Days & Holy Days',
    feastText: 'Major feasts such as the Transfiguration, the Assumption of Mary, the Exaltation of the Holy Cross and our own Feast of the Sacred Heart are usually celebrated with an evening Mass at 7 PM. Watch Instagram for each feast\'s flyer.',
    feastCta: 'See recent feast days',
    sacTitle: 'The Sacraments',
    sacLede: 'Whether you are welcoming a new baby, preparing for marriage, or caring for someone who is ill, the parish office is your first step. Call during office hours and we will guide you.',
    sacraments: [
      ['Baptism', 'Welcome your child into the life of the Church. Call the office to schedule a Baptism and arrange preparation for parents and godparents.'],
      ['First Communion & Reconciliation', 'Prepared through our Saturday Catechism program for students in 3rd grade and up.', '/ministries/catechism'],
      ['Holy Matrimony', 'Congratulations! Please contact the office well before your intended date so that preparation can begin.'],
      ['Anointing of the Sick', 'If a loved one is seriously ill, in the hospital, or preparing for surgery, call the office to arrange a visit from a priest.'],
      ['Funerals', 'We walk with families in their time of loss. Your funeral home can contact the parish office, or call us directly.'],
      ['Reconciliation', 'Confessions every Friday and Saturday, 4 – 5 PM, before Mass.'],
    ],
    expectTitle: 'New to the Chaldean Mass?',
    expect: [
      'The Chaldean Mass, or Holy Qurbana, is one of the most ancient liturgies in Christianity. Many prayers are sung by the priest, the deacons and the choir, often in Aramaic, the language Jesus spoke.',
      'You don\'t need to understand every word to pray. Follow the rhythm of standing and kneeling, listen, and let the beauty of the liturgy lift your heart.',
      'Catholics who are prepared may receive Holy Communion. Everyone else is warmly invited to come forward with arms crossed over the chest to receive a blessing.',
    ],
    officeTitle: 'Questions? Call the office',
  },
  ar: {
    title: 'مواعيد القداس والأسرار',
    desc: 'مواعيد القداس الأسبوعية في كنيسة القلب الأقدس الكلدانية في وارن: الجمعة والسبت ٦ مساءً (سورث وعربي)، السبت ١٢:٣٠ ظهراً (إنجليزي)، الأحد ١٠ صباحاً (عربي) و١٢:٣٠ ظهراً (سورث). الاعتراف الجمعة والسبت ٤–٥ مساءً.',
    eyebrow: 'صلّوا معنا',
    lede: 'القربانا المقدسة هي قلب حياة رعيتنا. الجميع مرحّب بهم في كل قداس.',
    weekTitle: 'البرنامج الأسبوعي',
    weekNote: 'قد تتغيّر المواعيد في الأعياد والمناسبات. وعندها نعلن ذلك في القداس وعلى إنستغرام.',
    cards: [
      ['cross', 'القداس الإلهي', 'يُحتفل به بالسورث (الآرامية الحديثة) والعربية والإنجليزية. قداس السبت الساعة ١٢:٣٠ ظهراً بالإنجليزية، وتحضره عائلات التعليم المسيحي والمناولة الأولى.'],
      ['heart', 'سرّ الاعتراف', 'يُقدَّم سرّ المصالحة كل جمعة وسبت من ٤ إلى ٥ مساءً قبل القداس. لتحديد موعد آخر، اتصل بالمكتب.'],
      ['candle', 'السجود والمسبحة', 'اقضِ ساعة مع الرب أمام القربان المقدس. نصلّي السجود والمسبحة الوردية كل جمعة وسبت من ٥ إلى ٦ مساءً.'],
    ],
    feastTitle: 'الأعياد والمناسبات',
    feastText: 'نحتفل عادةً بالأعياد الكبرى مثل التجلّي وانتقال العذراء وعيد الصليب وعيد رعيتنا، عيد القلب الأقدس، بقداس مسائي الساعة ٧ مساءً. تابعوا إنستغرام لإعلان كل عيد.',
    feastCta: 'الأعياد الأخيرة',
    sacTitle: 'الأسرار المقدسة',
    sacLede: 'سواء كنت تستقبل طفلاً جديداً، أو تستعدّ للزواج، أو ترعى مريضاً، فإن مكتب الكنيسة هو خطوتك الأولى. اتصل خلال ساعات الدوام وسنرشدك.',
    sacraments: [
      ['المعمودية', 'رحّب بطفلك في حياة الكنيسة. اتصل بالمكتب لتحديد موعد العماد وترتيب التحضير للوالدين والعرّابين.'],
      ['المناولة الأولى والمصالحة', 'يتم التحضير لهما من خلال برنامج التعليم المسيحي يوم السبت للطلاب من الصف الثالث فما فوق.', '/ministries/catechism'],
      ['سرّ الزواج', 'مبروك! يرجى التواصل مع المكتب قبل الموعد المقترح بوقت كافٍ ليبدأ التحضير.'],
      ['مسحة المرضى', 'إذا كان أحد أحبّائك مريضاً بشدّة أو في المستشفى أو يستعدّ لعملية جراحية، اتصل بالمكتب لترتيب زيارة من الكاهن.'],
      ['الجنازات', 'نرافق العائلات في وقت الفقد. يمكن لدار الجنازات التواصل مع مكتب الكنيسة، أو اتصل بنا مباشرة.'],
      ['سرّ المصالحة', 'الاعتراف كل جمعة وسبت، ٤ – ٥ مساءً، قبل القداس.'],
    ],
    expectTitle: 'جديد على القداس الكلداني؟',
    expect: [
      'القداس الكلداني، أو القربانا المقدسة، هو من أقدم الطقوس في المسيحية. يرتّل الكاهن والشمامسة والجوقة كثيراً من الصلوات، وغالباً بالآرامية، اللغة التي تكلّم بها يسوع.',
      'لست بحاجة إلى فهم كل كلمة لكي تصلّي. اتبع إيقاع الوقوف والركوع، وأصغِ، ودع جمال الطقس يرفع قلبك.',
      'يمكن للكاثوليك المستعدّين أن يتناولوا القربان المقدس. والجميع مدعوّون بمحبة للتقدّم واضعين أذرعهم متقاطعة على الصدر لنيل البركة.',
    ],
    officeTitle: 'لديك أسئلة؟ اتصل بالمكتب',
  },
}[lang];
---
<Base lang={lang} title={c.title} description={c.desc}>
  <PageHero lang={lang} eyebrow={c.eyebrow} title={c.title} lede={c.lede} image="/images/sanctuary-full.webp" />

  <section class="section-tight">
    <div class="wrap">
      <div class="section-head split reveal">
        <h2>{c.weekTitle}</h2>
        <p class="week-note"><Icon name="info" size={18} /> {c.weekNote}</p>
      </div>
      <div class="reveal"><ScheduleWeek lang={lang} /></div>
    </div>
  </section>

  <section class="section-tight">
    <div class="wrap grid grid-3">
      {c.cards.map(([i, h, p]) => (
        <div class="info card reveal">
          <span class="info-icon"><Icon name={i as 'cross'} size={24} /></span>
          <h3>{h}</h3>
          <p>{p}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="section-tight">
    <div class="wrap">
      <div class="feast card reveal">
        <img src="/images/ig/exaltation-reel.webp" alt="" loading="lazy" />
        <div>
          <p class="eyebrow">{lang === 'en' ? 'Evening Masses' : 'قداديس مسائية'}</p>
          <h2>{c.feastTitle}</h2>
          <p>{c.feastText}</p>
          <div class="btn-row">
            <a class="btn" href={href(routes.events, lang)}>{c.feastCta}</a>
            <a class="btn btn-ghost" href={site.social.instagram} target="_blank" rel="noopener"><Icon name="instagram" /> Instagram</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-paper" id="sacraments">
    <div class="wrap">
      <div class="section-head center reveal">
        <p class="eyebrow">{lang === 'en' ? 'Grace for every season of life' : 'نعمة لكل مراحل الحياة'}</p>
        <h2>{c.sacTitle}</h2>
        <p class="lede">{c.sacLede}</p>
      </div>
      <div class="grid grid-3">
        {c.sacraments.map(([h, p, link]) => (
          <div class="sac reveal">
            <h3>{h}</h3>
            <p>{p}</p>
            {link
              ? <a class="link-arrow" href={href(link, lang)}>{lang === 'en' ? 'Catechism program' : 'برنامج التعليم المسيحي'} <Icon name="arrow" size={16} /></a>
              : <a class="link-arrow" href={`tel:${site.phone.tel}`}><Icon name="phone" size={16} /> <span dir="ltr">{site.phone.display}</span></a>}
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap expect-grid">
      <div class="arch expect-arch reveal">
        <div class="arch-inner"><img src="/images/chalice.webp" alt={lang === 'en' ? 'Chalice and Host on the altar' : 'الكأس والقربان على المذبح'} loading="lazy" /></div>
      </div>
      <div class="reveal">
        <p class="eyebrow">{lang === 'en' ? 'What to expect' : 'ماذا تتوقّع'}</p>
        <h2>{c.expectTitle}</h2>
        <div class="prose">{c.expect.map((p) => <p>{p}</p>)}</div>
        <div class="office card">
          <strong>{c.officeTitle}</strong>
          <a href={`tel:${site.phone.tel}`} dir="ltr"><Icon name="phone" /> {site.phone.display}</a>
          <span>{site.officeHours[lang]}</span>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .section-head h2 { margin: 0; }
  .week-note { display: flex; gap: 8px; align-items: flex-start; max-width: 520px; margin: 0; color: var(--muted); font-size: 0.98rem; }
  .week-note :global(svg) { color: var(--gold); flex: none; margin-top: 4px; }
  .info { padding: 28px; }
  .info-icon { width: 52px; height: 52px; display: grid; place-items: center; border-radius: 14px; background: var(--cream-2); color: var(--burgundy); margin-bottom: 16px; border: 1px solid var(--line-gold); }
  .info p { color: var(--ink-2); font-size: 1rem; margin: 0; }
  .feast { display: grid; grid-template-columns: 280px 1fr; gap: clamp(24px, 4vw, 48px); align-items: center; padding: 16px; padding-inline-end: clamp(20px, 4vw, 48px); background: linear-gradient(135deg, var(--paper), #fbf1df); }
  .feast img { width: 100%; aspect-ratio: 3 / 4; object-fit: cover; border-radius: 16px; }
  .feast p:not(.eyebrow) { color: var(--ink-2); }
  .sac { padding: 26px; border-radius: var(--radius-lg); background: var(--cream); border: 1px solid var(--line); display: flex; flex-direction: column; }
  .sac h3 { font-size: 1.45rem; }
  .sac p { color: var(--ink-2); font-size: 1rem; flex: 1; }
  .expect-grid { display: grid; grid-template-columns: 0.7fr 1.3fr; gap: clamp(32px, 6vw, 88px); align-items: center; }
  .expect-arch { aspect-ratio: 3 / 4.4; max-width: 340px; width: 100%; justify-self: center; }
  .office { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 20px; padding: 18px 22px; margin-top: 1.4rem; }
  .office strong { width: 100%; font-family: var(--serif); font-size: 1.3rem; color: var(--burgundy-deep); }
  .office a { display: inline-flex; gap: 8px; align-items: center; font-weight: 700; font-size: 1.2rem; text-decoration: none; }
  .office span { color: var(--muted); font-size: 0.95rem; }
  @media (max-width: 820px) {
    .feast, .expect-grid { grid-template-columns: 1fr; }
    .feast { padding-inline-end: 24px; padding-bottom: 28px; }
    .feast img { aspect-ratio: 16 / 10; }
  }
</style>
