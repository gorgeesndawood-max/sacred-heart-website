---
import Icon from './Icon.astro';
import { site, schedule, type Lang } from '../data/site';
import { ministries } from '../data/ministries';
import { t, href, routes, altPath } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const bare = lang === 'ar' ? path.replace(/^\/ar/, '') || '/' : path;
const isActive = (r: string) => (r === '/' ? bare === '/' : bare.startsWith(r));

const nav = [
  { key: 'nav.about', to: routes.about },
  { key: 'nav.mass', to: routes.mass },
  { key: 'nav.ministries', to: routes.ministries, menu: true },
  { key: 'nav.events', to: routes.events },
  { key: 'nav.contact', to: routes.contact },
] as const;

// Data for the client-side "Next Mass" countdown.
const massData = JSON.stringify(
  schedule.filter((s) => s.kind === 'mass').map((s) => ({ d: s.day, t: s.time, l: s.lang?.[lang] ?? '' })),
);
---
<div class="topbar">
  <div class="wrap topbar-inner">
    <p class="next-mass" data-next-mass={massData} data-lang={lang}>
      <Icon name="candle" size={16} />
      <span class="nm-label">{t(lang, 'topbar.next')}:</span>
      <span class="nm-value">
        {lang === 'en' ? 'Fri & Sat 6 PM · Sun 10 AM & 12:30 PM' : 'الجمعة والسبت ٦ مساءً · الأحد ١٠ صباحاً و١٢:٣٠ ظهراً'}
      </span>
    </p>
    <div class="topbar-links">
      <a href={site.mapsUrl} target="_blank" rel="noopener"><Icon name="pin" size={15} /> <span class="hide-sm" dir="ltr">{site.address.oneLine}</span><span class="show-sm">{lang === 'en' ? 'Directions' : 'الاتجاهات'}</span></a>
      <a href={`tel:${site.phone.tel}`} dir="ltr"><Icon name="phone" size={15} /> {site.phone.display}</a>
    </div>
  </div>
</div>

<header class="site-header" data-header>
  <div class="wrap header-inner">
    <a class="brand" href={href('/', lang)} aria-label={site.name[lang]}>
      <img src="/images/logo.webp" alt="" width="42" height="68" />
      <span class="brand-text">
        <span class="brand-name">{lang === 'en' ? 'Sacred Heart' : 'كنيسة القلب الأقدس'}</span>
        <span class="brand-sub">{lang === 'en' ? 'Chaldean Catholic Church' : 'الكلدانية الكاثوليكية'}</span>
      </span>
    </a>

    <nav class="main-nav" aria-label="Main">
      <ul>
        {nav.map((n) => (
          <li class={'menu' in n ? 'has-menu' : undefined}>
            <a href={href(n.to, lang)} aria-current={isActive(n.to) ? 'page' : undefined}>
              {t(lang, n.key)}
              {'menu' in n && <Icon name="chevron" size={14} class="chev" />}
            </a>
            {'menu' in n && (
              <div class="mega">
                <div class="mega-grid">
                  {ministries.map((m) => (
                    <a href={href(`/ministries/${m.slug}`, lang)}>
                      <strong>{m.name[lang]}</strong>
                      <span>{m.tagline[lang]}</span>
                    </a>
                  ))}
                </div>
                <a class="mega-all link-arrow" href={href(routes.ministries, lang)}>{t(lang, 'nav.allMinistries')} <Icon name="arrow" size={16} /></a>
              </div>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <div class="header-actions">
      <a class="lang-toggle" href={altPath(Astro.url.pathname, lang)} hreflang={lang === 'en' ? 'ar' : 'en'} lang={lang === 'en' ? 'ar' : 'en'} aria-label={t(lang, 'lang.switchLabel')} data-lang-toggle>
        <Icon name="globe" size={17} /> {t(lang, 'lang.switch')}
      </a>
      <a class="btn btn-sm hide-md" href={href(routes.contact, lang) + '#signup'}>{t(lang, 'nav.getInvolved')}</a>
      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="mobile-nav" data-menu-btn>
        <Icon name="menu" size={24} />
        <span class="sr-only">{t(lang, 'nav.menu')}</span>
      </button>
    </div>
  </div>
</header>

<div class="mobile-nav" id="mobile-nav" hidden data-mobile-nav>
  <div class="mobile-nav-inner">
    <button class="menu-close" type="button" data-menu-close><Icon name="x" size={26} /><span class="sr-only">{t(lang, 'nav.close')}</span></button>
    <ul>
      <li><a href={href('/', lang)}>{t(lang, 'nav.home')}</a></li>
      {nav.map((n) => 'menu' in n ? (
        <li>
          <details class="m-sub">
            <summary>{t(lang, n.key)} <Icon name="chevron" size={22} /></summary>
            <ul>
              <li><a href={href(n.to, lang)}>{t(lang, 'nav.allMinistries')}</a></li>
              {ministries.map((m) => <li><a href={href(`/ministries/${m.slug}`, lang)}>{m.name[lang]}</a></li>)}
            </ul>
          </details>
        </li>
      ) : <li><a href={href(n.to, lang)} aria-current={isActive(n.to) ? 'page' : undefined}>{t(lang, n.key)}</a></li>)}
      <li><a href={href(routes.support, lang)}>{t(lang, 'nav.support')}</a></li>
    </ul>
    <div class="mobile-nav-foot">
      <a class="btn" href={href(routes.contact, lang) + '#signup'}>{t(lang, 'nav.getInvolved')}</a>
      <a class="btn btn-ghost" href={`tel:${site.phone.tel}`} dir="ltr"><Icon name="phone" size={18} /> {site.phone.display}</a>
      <a class="btn btn-ghost" href={altPath(Astro.url.pathname, lang)}><Icon name="globe" size={18} /> {t(lang, 'lang.switch')}</a>
    </div>
  </div>
</div>

<nav class="action-bar" aria-label={lang === 'en' ? 'Quick actions' : 'إجراءات سريعة'}>
  <a href={href(routes.mass, lang)}><Icon name="clock" size={22} /><span>{lang === 'en' ? 'Mass' : 'القداس'}</span></a>
  <a href={`tel:${site.phone.tel}`}><Icon name="phone" size={22} /><span>{t(lang, 'cta.call')}</span></a>
  <a href={site.mapsUrl} target="_blank" rel="noopener"><Icon name="pin" size={22} /><span>{lang === 'en' ? 'Directions' : 'الاتجاهات'}</span></a>
  <a class="ab-primary" href={href(routes.contact, lang) + '#signup'}><Icon name="users" size={22} /><span>{lang === 'en' ? 'Join' : 'انضمّ'}</span></a>
</nav>

<style>
  .action-bar { display: none; }
  @media (max-width: 720px) {
    .action-bar {
      position: fixed; z-index: 60; inset-inline: 0; bottom: 0;
      display: grid; grid-template-columns: repeat(4, 1fr);
      padding: 6px 8px calc(6px + env(safe-area-inset-bottom));
      background: rgba(58, 13, 19, 0.96); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
      border-top: 1px solid rgba(234, 215, 168, 0.25); box-shadow: 0 -8px 24px rgba(0, 0, 0, 0.18);
    }
    .action-bar a {
      display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 3px;
      min-height: 54px; border-radius: 12px; color: #f0e2c8; text-decoration: none; font-size: 0.78rem; font-weight: 600;
    }
    .action-bar a :global(svg) { color: var(--gold-2); }
    .action-bar a:active { background: rgba(255, 255, 255, 0.08); }
    .action-bar .ab-primary { background: var(--gold); color: #fff; }
    .action-bar .ab-primary :global(svg) { color: #fff; }
    :global(body) { padding-bottom: calc(68px + env(safe-area-inset-bottom)); }
  }
  .m-sub summary {
    list-style: none; cursor: pointer; display: flex; justify-content: space-between; align-items: center;
    padding: 14px 4px; border-bottom: 1px solid var(--line);
    font-family: var(--serif); font-size: 1.7rem; font-weight: 600; color: var(--burgundy-deep);
  }
  .m-sub summary::-webkit-details-marker { display: none; }
  .m-sub summary :global(svg) { color: var(--gold); transition: transform 0.2s; }
  .m-sub[open] summary :global(svg) { transform: rotate(180deg); }
  .m-sub ul { margin: 4px 0 8px !important; padding-inline-start: 12px !important; }
  .mobile-nav .m-sub li a { font-family: var(--sans); font-size: 1.05rem; font-weight: 600; padding: 10px 4px; color: var(--ink); border-bottom: 1px dashed var(--line); }
  .topbar { background: var(--burgundy-deep); color: #ecdcc2; font-size: 0.9rem; }
  .topbar-inner { display: flex; align-items: center; justify-content: space-between; gap: 12px; min-height: 40px; }
  .topbar p { margin: 0; display: flex; align-items: center; gap: 8px; min-width: 0; }
  .topbar :global(svg) { color: var(--gold-2); flex: none; }
  .nm-label { color: var(--gold-2); font-weight: 600; white-space: nowrap; }
  .nm-value { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .topbar-links { display: flex; gap: 20px; flex: none; }
  .topbar-links a { color: #ecdcc2; text-decoration: none; display: inline-flex; align-items: center; gap: 6px; white-space: nowrap; }
  .topbar-links a:hover { color: #fff; }
  .show-sm { display: none; }

  .site-header {
    position: sticky; top: 0; z-index: 50;
    background: rgba(248, 242, 231, 0.9);
    backdrop-filter: saturate(1.4) blur(12px);
    -webkit-backdrop-filter: saturate(1.4) blur(12px);
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s, box-shadow 0.3s;
  }
  .site-header.scrolled { border-color: var(--line); box-shadow: 0 6px 24px rgba(58, 13, 19, 0.06); }
  .header-inner { display: flex; align-items: center; gap: 24px; min-height: 80px; }

  .brand { display: flex; align-items: center; gap: 12px; text-decoration: none; flex: none; }
  .brand img { height: 56px; width: auto; }
  .brand-text { display: flex; flex-direction: column; line-height: 1.1; }
  .brand-name { font-family: var(--caps); font-size: 1.3rem; font-weight: 700; letter-spacing: 0.06em; color: var(--burgundy); }
  .brand-sub { font-family: var(--caps); font-size: 0.68rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--gold); margin-top: 3px; }
  :global(html[lang='ar']) .brand-name { font-size: 1.35rem; letter-spacing: 0; }
  :global(html[lang='ar']) .brand-sub { font-size: 0.9rem; letter-spacing: 0; }

  .main-nav { margin-inline-start: auto; }
  .main-nav ul { list-style: none; margin: 0; padding: 0; display: flex; gap: 4px; }
  .main-nav li { position: relative; }
  .main-nav > ul > li > a {
    display: inline-flex; align-items: center; gap: 4px;
    padding: 10px 14px; border-radius: 999px;
    color: var(--ink); text-decoration: none; font-weight: 600; font-size: 1rem;
    transition: background 0.2s, color 0.2s;
  }
  .main-nav > ul > li > a:hover, .main-nav > ul > li > a[aria-current='page'] { background: var(--cream-2); color: var(--burgundy); }
  .main-nav > ul > li > a[aria-current='page'] { box-shadow: inset 0 0 0 1px var(--line); }
  .chev { transition: transform 0.2s; opacity: 0.6; }
  .has-menu:hover .chev, .has-menu:focus-within .chev { transform: rotate(180deg); }

  .mega {
    position: absolute; top: calc(100% + 8px); inset-inline-start: 50%; translate: -50% 0;
    width: min(760px, 90vw); padding: 20px;
    background: var(--paper); border: 1px solid var(--line); border-radius: var(--radius-lg); box-shadow: var(--shadow-lg);
    opacity: 0; visibility: hidden; transform: translateY(6px);
    transition: opacity 0.2s, transform 0.2s, visibility 0.2s;
  }
  :global([dir='rtl']) .mega { translate: 50% 0; }
  .mega::before { content: ''; position: absolute; inset: -12px 0 auto; height: 12px; }
  .has-menu:hover .mega, .has-menu:focus-within .mega { opacity: 1; visibility: visible; transform: none; }
  .mega-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 4px; }
  .mega-grid a { display: block; padding: 10px 12px; border-radius: 10px; text-decoration: none; color: var(--ink); }
  .mega-grid a:hover { background: var(--cream); }
  .mega-grid strong { display: block; font-size: 0.95rem; color: var(--burgundy-deep); }
  .mega-grid span { display: block; font-size: 0.82rem; color: var(--muted); line-height: 1.4; margin-top: 2px; }
  .mega-all { margin: 12px 12px 0; font-size: 0.95rem; }

  .header-actions { display: flex; align-items: center; gap: 10px; flex: none; }
  .lang-toggle {
    display: inline-flex; align-items: center; gap: 6px; padding: 8px 14px; min-height: 42px;
    border-radius: 999px; border: 1px solid var(--line-gold); color: var(--burgundy);
    text-decoration: none; font-weight: 600; font-size: 0.98rem; background: var(--paper);
  }
  .lang-toggle[lang='ar'] { font-family: 'IBM Plex Sans Arabic', sans-serif; }
  .lang-toggle:hover { border-color: var(--gold); background: #fff; }
  .menu-btn, .menu-close { display: none; background: none; border: 0; color: var(--burgundy); padding: 8px; cursor: pointer; border-radius: 10px; }

  .mobile-nav { position: fixed; inset: 0; z-index: 100; background: rgba(58, 13, 19, 0.5); }
  .mobile-nav-inner {
    position: absolute; inset-block: 0; inset-inline-end: 0; width: min(420px, 100%);
    background: var(--cream); padding: 20px 24px 32px; display: flex; flex-direction: column; overflow-y: auto;
    animation: slide 0.3s var(--ease);
  }
  :global([dir='rtl']) .mobile-nav-inner { animation-name: slide-rtl; }
  @keyframes slide { from { transform: translateX(100%); } }
  @keyframes slide-rtl { from { transform: translateX(-100%); } }
  .menu-close { display: block; align-self: flex-end; }
  .mobile-nav ul { list-style: none; padding: 0; margin: 12px 0 24px; }
  .mobile-nav li a {
    display: block; padding: 14px 4px; border-bottom: 1px solid var(--line);
    font-family: var(--serif); font-size: 1.7rem; font-weight: 600; color: var(--burgundy-deep); text-decoration: none;
  }
  .mobile-nav li a[aria-current='page'] { color: var(--flame); }
  .mobile-nav-foot { display: grid; gap: 10px; margin-top: auto; }

  @media (max-width: 1120px) { .hide-md { display: none; } }
  @media (max-width: 980px) {
    .main-nav { display: none; }
    .menu-btn { display: inline-flex; }
    .header-actions { margin-inline-start: auto; }
  }
  @media (max-width: 720px) {
    .nm-label { display: none; }
    .hide-sm { display: none; }
    .show-sm { display: inline; }
    .topbar-links { display: none; }
    .topbar-inner { justify-content: center; }
  }
  @media (max-width: 520px) {
    .header-inner { min-height: 68px; gap: 12px; }
    .brand img { height: 46px; }
    .brand-name { font-size: 1.1rem; }
    .brand-sub { font-size: 0.58rem; letter-spacing: 0.1em; }
    .lang-toggle { padding: 6px 10px; }
    .lang-toggle :global(svg) { display: none; }
  }
</style>

<script>
  // Sticky header shadow
  const header = document.querySelector('[data-header]');
  const onScroll = () => header?.classList.toggle('scrolled', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  // Mobile menu
  const panel = document.querySelector<HTMLElement>('[data-mobile-nav]');
  const openBtn = document.querySelector<HTMLButtonElement>('[data-menu-btn]');
  const closeBtn = document.querySelector<HTMLButtonElement>('[data-menu-close]');
  const setOpen = (open: boolean) => {
    if (!panel || !openBtn) return;
    panel.hidden = !open;
    openBtn.setAttribute('aria-expanded', String(open));
    document.body.style.overflow = open ? 'hidden' : '';
    if (open) closeBtn?.focus(); else openBtn.focus();
  };
  openBtn?.addEventListener('click', () => setOpen(true));
  closeBtn?.addEventListener('click', () => setOpen(false));
  panel?.addEventListener('click', (e) => { if (e.target === panel) setOpen(false); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && panel && !panel.hidden) setOpen(false); });

  // Remember language choice; keep the #hash when switching.
  document.querySelectorAll<HTMLAnchorElement>('[data-lang-toggle]').forEach((a) => {
    a.addEventListener('click', () => {
      try { localStorage.setItem('shccc-lang', a.hreflang); } catch {}
      if (location.hash) a.href += location.hash;
    });
  });

  // "Next Mass" — computed in Detroit time so it is right for every visitor.
  const el = document.querySelector<HTMLElement>('[data-next-mass]');
  if (el) {
    type M = { d: number; t: string; l: string };
    const masses: M[] = JSON.parse(el.dataset.nextMass || '[]');
    const ar = el.dataset.lang === 'ar';
    const parts = new Intl.DateTimeFormat('en-US', { timeZone: 'America/Detroit', weekday: 'short', hour: 'numeric', minute: 'numeric', hourCycle: 'h23' }).formatToParts(new Date());
    const get = (k: string) => parts.find((p) => p.type === k)?.value ?? '';
    const dayIdx = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'].indexOf(get('weekday'));
    const nowMin = dayIdx * 1440 + Number(get('hour')) * 60 + Number(get('minute'));
    const withMin = masses.map((m) => { const [h, mi] = m.t.split(':').map(Number); return { ...m, min: m.d * 1440 + h * 60 + mi }; });
    // Mass is still "next" until 30 minutes after it starts.
    const next = withMin.filter((m) => m.min + 30 > nowMin).sort((a, b) => a.min - b.min)[0]
      ?? withMin.sort((a, b) => a.min - b.min)[0];
    if (next) {
      const [h, mi] = next.t.split(':').map(Number);
      const h12 = ((h + 11) % 12) + 1;
      const enDays = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
      const arDays = ['الأحد', 'الاثنين', 'الثلاثاء', 'الأربعاء', 'الخميس', 'الجمعة', 'السبت'];
      const diff = next.min - nowMin;
      const inProgress = diff <= 0 && diff > -30;
      const today = next.d === dayIdx && diff > -30;
      const tomorrow = next.d === (dayIdx + 1) % 7;
      const timeStr = `${h12}:${String(mi).padStart(2, '0')} ${ar ? (h < 12 ? 'صباحاً' : 'مساءً') : h < 12 ? 'AM' : 'PM'}`;
      const dayStr = inProgress ? (ar ? 'جارٍ الآن' : 'Happening now') : today ? (ar ? 'اليوم' : 'Today') : tomorrow ? (ar ? 'غداً' : 'Tomorrow') : ar ? arDays[next.d] : enDays[next.d];
      const out = el.querySelector('.nm-value');
      if (out) out.textContent = `${dayStr} · ${timeStr}${next.l ? ` · ${next.l}` : ''}`;
    }
  }
</script>
